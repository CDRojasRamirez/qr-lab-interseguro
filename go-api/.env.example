PORT=8080
LOG_LEVEL=info

# Node statistics API
STATS_API_URL=http://localhost:3000
STATS_TIMEOUT=3s

# JWT (RS256). Provide the private key inline (literal \n accepted) or by path.
# Generate a pair with: make keygen
JWT_PRIVATE_KEY_PATH=../keys/private.pem
# JWT_PRIVATE_KEY=
JWT_ISSUER=qr-go-api
JWT_AUDIENCE=qr-challenge
JWT_TTL=15m

# Demo credentials (a real system would use a user store with hashed passwords)
AUTH_USERNAME=admin
AUTH_PASSWORD=secret

# CORS (comma separated) and request body limit in bytes
ALLOWED_ORIGINS=http://localhost:4200
BODY_LIMIT=524288
