PORT=3000
LOG_LEVEL=info
DIAGONAL_EPSILON=1e-10

# JWT (RS256, verify only). Provide ONE of the two key sources.
# Inline PEM (literal \n escapes are accepted):
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"
# ...or a path to a PEM file:
JWT_PUBLIC_KEY_PATH=../keys/public.pem
JWT_ISSUER=qr-go-api
JWT_AUDIENCE=qr-challenge

# Comma-separated CORS origins
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080
BODY_LIMIT=512kb
