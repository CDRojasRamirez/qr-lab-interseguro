# Optional overrides for docker-compose (copy to `.env` in the repo root).
# Every value shown is already the default.
AUTH_USERNAME=admin
AUTH_PASSWORD=secret
JWT_ISSUER=qr-go-api
JWT_AUDIENCE=qr-challenge
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080
# Host ports (change them if 8080/3000 are already taken on your machine).
GO_API_HOST_PORT=8080
NODE_API_HOST_PORT=3000
FRONTEND_HOST_PORT=4200
